{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "orbit",
  "version": "0.6.3",
  "description": "统计和排序 Linear My Issues，定位可继续的 Codex 聊天，并支持任务开发与结果回传。",
  "author": {
    "name": "Sevenova"
  },
  "repository": "https://github.com/SevenovaHangzhou/Personal_workstation_qyx",
  "keywords": [
    "linear",
    "tasks",
    "codex"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/orbit-setup/SKILL.md",
      "interface": {
        "displayName": "星序 / ORBIT",
        "shortDescription": "Linear 任务盘点、聊天导航与自动日报",
        "developerName": "Sevenova",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "拉取我的 Linear 任务",
          "将本次开发结果整理并回传到当前 issue",
          "统计我的未完成 issue，按解决顺序排序并找到对应聊天"
        ]
      }
    }
  }
}
